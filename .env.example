# Set this to the deployed backend origin or complete API base URL.
# The client adds /api/v1 when needed.
VITE_API_URL=https://your-api.example.com

# Use this only when the frontend host proxies /api to the backend.
# VITE_API_BASE_URL=/api

# Optional local Vite proxy target for same-origin development.
# VITE_API_PROXY_TARGET=http://localhost:3000
